# Salin ke .env lalu ganti setiap nilai "change-me". File .env tidak boleh di-commit.
# Gunakan nilai URL-safe (huruf/angka), mis. hasil `openssl rand -hex 16`, karena dipakai di dalam URL koneksi.

# --- PostgreSQL (container db) ---
POSTGRES_SUPERUSER_PASSWORD=change-me
# Pemilik skema: dipakai migration + seed saja.
APP_OWNER_PASSWORD=change-me
# Role runtime API: bukan owner/superuser, tidak bisa UPDATE/DELETE audit_events.
APP_RUNTIME_PASSWORD=change-me
DB_HOST_PORT=5433

# --- Aplikasi ---
# Password semua akun demo (*@example.test); di-hash saat seed.
DEMO_PASSWORD=change-me
# Secret penandatangan token login (min. 32 karakter), mis. `openssl rand -hex 32`.
JWT_SECRET=change-me-min-32-characters-change-me
# Masa berlaku token dalam detik (default 1 jam).
JWT_EXPIRES_IN_SECONDS=3600
# true bila diakses lewat HTTPS (produksi); false untuk http://localhost.
COOKIE_SECURE=false
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# --- Menjalankan API/test di host (tanpa container api) ---
# Ganti <runtime>/<owner> dengan password di atas.
DATABASE_URL=postgresql://app_runtime:<runtime>@localhost:5433/support
MIGRATION_DATABASE_URL=postgresql://app_owner:<owner>@localhost:5433/support
# Database test terpisah; reset hanya diizinkan bila nama database berakhiran _test.
DATABASE_URL_TEST=postgresql://app_runtime:<runtime>@localhost:5433/support_test
MIGRATION_DATABASE_URL_TEST=postgresql://app_owner:<owner>@localhost:5433/support_test
